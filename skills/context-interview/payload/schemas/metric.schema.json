{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodaldata.io/acf/metric.schema.json",
  "title": "ACF Metric",
  "type": "object",
  "required": [
    "metrics"
  ],
  "properties": {
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "definition",
          "status"
        ],
        "dependentRequired": {
          "expression": [
            "grain"
          ]
        },
        "properties": {
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "grain": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "confirmed"
            ]
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "common_filters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expression": {
            "type": "object",
            "required": [
              "measure"
            ],
            "properties": {
              "measure": {
                "type": "string",
                "description": "Aggregates of lineage columns, metric(<name>) references to another metric in this file, arithmetic (+ - * /), parentheses and numerals only. Never runnable SQL. Column measures require lineage; reference-only arithmetic inherits the union of referenced lineage."
              },
              "mandatory_filters": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/filterOrGroup"
                }
              },
              "allowed_dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "entity_filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "entity",
                    "having"
                  ],
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "having": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "measure",
                          "op",
                          "value"
                        ],
                        "properties": {
                          "measure": {
                            "type": "string"
                          },
                          "op": {
                            "type": "string"
                          },
                          "value": {}
                        },
                        "additionalProperties": false
                      }
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "lineage": {
            "$ref": "lineage.schema.json"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "filter": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "value": {},
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "filterOrGroup": {
      "oneOf": [
        {
          "$ref": "#/$defs/filter"
        },
        {
          "type": "object",
          "required": [
            "any_of"
          ],
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filterOrGroup"
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all_of"
          ],
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filterOrGroup"
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
