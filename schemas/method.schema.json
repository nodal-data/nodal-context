{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodaldata.io/acf/method.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "kind": {
      "const": "method"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ],
      "deprecated": true,
      "description": "Legacy migration evidence only; never grants approval. Drafts remain blocked until reviewed conversion."
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "format": "date"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "alias_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lineage": {
      "oneOf": [
        {
          "const": "inherit"
        },
        {
          "$ref": "lineage.schema.json"
        }
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "default": {},
          "dimension": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "value": {},
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "value",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "without_this": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "overrides": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "filter_field": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "metric",
              "filter_field",
              "reason"
            ],
            "additionalProperties": false
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "filter": {
                  "$ref": "metric.schema.json#/$defs/filterOrGroup"
                }
              },
              "required": [
                "metric",
                "filter"
              ],
              "additionalProperties": false
            }
          },
          "alignment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "rule",
          "without_this"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "output": {
      "type": "object",
      "properties": {
        "grain": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "must_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "optional_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "grain",
        "columns",
        "must_state"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "not_this": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "interview",
            "notebook",
            "dashboard"
          ]
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "extracted_at": {
          "type": "string",
          "format": "date"
        },
        "extracted_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "draft",
              "confirmed"
            ]
          },
          "approver": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "description": "Historical attribution only. Does not grant current approval."
    }
  },
  "required": [
    "name",
    "kind",
    "domain",
    "aliases",
    "description",
    "metrics",
    "parameters",
    "decisions",
    "output",
    "checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approver",
          "confirmed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "decisions": {
            "items": {
              "properties": {
                "without_this": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
