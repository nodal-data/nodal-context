{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodaldata.io/acf/domain.schema.json",
  "title": "ACF Domain",
  "type": "object",
  "required": [
    "name",
    "summary",
    "grain",
    "lineage"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ],
      "deprecated": true,
      "description": "Legacy migration evidence only; never grants approval. Drafts remain blocked until reviewed conversion."
    },
    "owner": {
      "type": "string"
    },
    "grain": {
      "type": "string"
    },
    "tables": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "string"
        },
        "others": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dashboards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "canonical_question": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "lineage": {
      "$ref": "lineage.schema.json"
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "draft",
              "confirmed"
            ]
          },
          "approver": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "description": "Historical attribution only. Does not grant current approval."
    }
  },
  "additionalProperties": false
}
