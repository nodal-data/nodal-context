{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodaldata.io/acf/metric.schema.json",
  "type": "object",
  "required": [
    "name",
    "definition"
  ],
  "dependentRequired": {
    "expression": [
      "grain"
    ],
    "expression_blocked_by": [
      "deterministic_form"
    ],
    "deterministic_form": [
      "expression_blocked_by"
    ]
  },
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "definition": {
      "type": "string"
    },
    "grain": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ],
      "deprecated": true,
      "description": "Legacy migration evidence only; never grants approval. Drafts remain blocked until reviewed conversion."
    },
    "parameters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "default": {},
              "dimension": {
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "shared": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "shared"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_filters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expression": {
      "type": "object",
      "required": [
        "measure"
      ],
      "properties": {
        "measure": {
          "type": "string",
          "description": "Restricted aggregate/arithmetic grammar; metric(name) or metric(domain.name) references. Never runnable SQL."
        },
        "mandatory_filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filterOrGroup"
          }
        },
        "allowed_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entity_filters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity",
              "having"
            ],
            "properties": {
              "entity": {
                "type": "string"
              },
              "having": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "measure",
                    "op",
                    "value"
                  ],
                  "properties": {
                    "measure": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "additionalProperties": false
                }
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "include_filters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ratio": {
          "type": "object",
          "properties": {
            "zero_denominator": {
              "enum": [
                null,
                "zero",
                "error"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "zero_denominator",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "oneOf": [
        {
          "$ref": "lineage.schema.json"
        },
        {
          "const": "inherit"
        },
        {
          "type": "object",
          "properties": {
            "shared": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "shared"
          ],
          "additionalProperties": false
        }
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "format": "date"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "alias_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "temporal_kind": {
      "enum": [
        "stock",
        "flow",
        "rate"
      ]
    },
    "family": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "discriminator": {
          "type": "string",
          "minLength": 1
        },
        "siblings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "discriminator",
        "siblings"
      ],
      "additionalProperties": false
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "question",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "expression_blocked_by": {
      "type": "string",
      "minLength": 1
    },
    "deterministic_form": {
      "type": "string",
      "minLength": 1
    },
    "allowed_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "draft",
              "confirmed"
            ]
          },
          "approver": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "description": "Historical attribution only. Does not grant current approval."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "filter": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "value": {},
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "filterOrGroup": {
      "oneOf": [
        {
          "$ref": "#/$defs/filter"
        },
        {
          "type": "object",
          "required": [
            "any_of"
          ],
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filterOrGroup"
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all_of"
          ],
          "properties": {
            "all_of": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filterOrGroup"
              }
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "title": "ACF 0.3 Metric",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approver",
          "confirmed_at"
        ]
      }
    },
    {
      "not": {
        "required": [
          "expression",
          "deterministic_form"
        ]
      }
    },
    {
      "not": {
        "required": [
          "expression",
          "allowed_dimensions"
        ]
      }
    }
  ]
}
